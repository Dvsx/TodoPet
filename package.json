{
  "name": "todopet",
  "version": "0.1.1",
  "author": "Harden",
  "description": "A local-first Windows todo and healthy-break companion with a pixel desktop pet.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:completion": "pnpm build && node scripts/verify-task-completion.cjs",
    "icon": "node scripts/make-icon.cjs",
    "package": "pnpm build && node scripts/clean-release.cjs && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@vueuse/core": "^13.0.0",
    "drizzle-orm": "^0.44.0",
    "electron-store": "^10.0.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "playwright": "^1.51.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.harden.todopet",
    "productName": "TodoPet",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pets",
        "to": "pets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon",
        "to": "icon",
        "filter": [
          "icon.png",
          "icon-tray.png"
        ]
      },
      {
        "from": "resources/windows",
        "to": "windows",
        "filter": [
          "display-power-monitor.ps1"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-TodoPet.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dvsx/TodoPet.git"
  },
  "homepage": "https://github.com/Dvsx/TodoPet",
  "bugs": {
    "url": "https://github.com/Dvsx/TodoPet/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  }
}
